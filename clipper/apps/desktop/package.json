{
  "name": "@gamerplug/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GamerPlug Clipper desktop shell — tray app, clip library, login, upload.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "dev:renderer": "vite",
    "pack:win": "pnpm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@gamerplug/ipc": "workspace:*",
    "@gamerplug/shared": "workspace:*",
    "@gamerplug/upload": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.0.5"
  }
}
